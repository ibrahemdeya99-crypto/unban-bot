# 🛡️ درع الحماية ضد الحظر والتوقف
async def safe_execute(message: Message, coro):
    try:
        return await coro
    except FloodWait as e:
        await message.reply_text(f"⚠️ **تنبيه أمان:** تم الوصول لحد طلبات تلغرام. الانتظار لمدة {e.value} ثانية لتجنب الحظر...")
        await asyncio.sleep(e.value)
        return None
    except UserAdminInvalid:
        await message.reply_text("❌ يرجى رفع البوت **مشرفاً** في المجموعة مع صلاحية إدارة الأعضاء.")
        return None
    except PeerIdInvalid:
        await message.reply_text("❌ المعرف أو الآيدي غير صحيح.")
        return None
    except RPCError as e:
        await message.reply_text(f"❌ خطأ تقني: {e.MESSAGE}")
        return None

@app.on_message(filters.command("start"))
