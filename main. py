import subprocess
import sys

# 1. التثبيت التلقائي للمكتبات
def install_requirements():
    for package in ["pyrogram", "tgcrypto"]:
        try:
            __import__(package)
        except ImportError:
            subprocess.check_call([sys.executable, "-m", "pip", "install", package])

install_requirements()

