@app.on_message(filters.command("unban") & filters.group)
async def unban_user(client: Client, message: Message):
    if len(message.command) < 2:
        await message.reply_text("ℹ️ أرسل معرف أو ID الحساب بعد الأمر. مثال:\n`/unban @username`")
        return

    target = message.command[1]
    
    async def action():
        await client.unban_chat_member(chat_id=message.chat.id, user_id=target)
        await message.reply_text(f"✅ تم فك الحظر بنجاح عن: `{target}`")

    await safe_execute(message, action())
    await asyncio.sleep(1.5)

@app.on_message(filters.command("check"))
async def check_user(client: Client, message: Message):
    if len(message.command) < 2:
        await message.reply_text("ℹ️ أرسل معرف أو ID الحساب للرصد.")
        return

    target = message.command[1]
    
    async def action():
        user = await client.get_users(target)
        info = (
            f"🔍 **تقرير الرصد:**\n\n"
            f"👤 **الاسم:** {user.first_name}\n"
            f"🆔 **الـ ID:** `{user.id}`\n"
            f"🚫 **الحالة:** {'مقيّد ⚠️' if user.is_restricted else 'سليم ✅'}"
        )
        await message.reply_text(info)

    await safe_execute(message, action())
    await asyncio.sleep(1)

# 🔄 تشغيل متواصل 24/7
async def run_bot():
